ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-business-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=your-business-email@example.com
# Optional: force one canonical site URL. If unset, sitemap & robots
# auto-detect the live domain from request headers (any host, zero config),
# and Vercel custom domains are picked up automatically from platform vars.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
